{
  "name": "page-proxy-workspace",
  "private": true,
  "version": "0.3.9",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "web",
    "extension",
    "docs-site",
    "packages/pp"
  ],
  "scripts": {
    "postinstall": "bun run --cwd extension prepare",
    "check": "bun run --cwd web check && bun run --cwd extension check",
    "lint": "bun run --cwd web lint && bun run --cwd extension lint",
    "test:unit": "bun run --cwd web test && bun run --cwd extension test && bun run --cwd packages/pp test",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:preview": "bun run --cwd web preview",
    "web:check": "bun run --cwd web check",
    "web:lint": "bun run --cwd web lint",
    "web:test": "bun run --cwd web test",
    "web:test:e2e": "bun run --cwd web test:e2e",
    "docs:dev": "bun run --cwd docs-site dev",
    "docs:build": "bun run --cwd docs-site build",
    "extension:generate-monaco-types": "bun run --cwd extension generate-monaco-types",
    "extension:dev": "bun run --cwd extension dev",
    "extension:build": "bun run --cwd extension build",
    "extension:prepare": "bun run --cwd extension prepare",
    "extension:check": "bun run --cwd extension check",
    "extension:lint": "bun run --cwd extension lint",
    "extension:test": "bun run --cwd extension test",
    "pp:build-runtime": "node ./packages/pp/scripts/build-browser-bundle.mjs",
    "pp:lint": "bun run --cwd packages/pp lint",
    "pp:test": "bun run --cwd packages/pp test",
    "clean": "bun run --cwd extension clean && rm -rf node_modules/.vite && rm -rf extension/node_modules"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "bun-types": "1.3.11",
    "jsdom": "29.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.1"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.3"
  },
  "dependencies": {
    "eslint": "^10.2.0",
    "typescript": "^6.0.2"
  }
}
