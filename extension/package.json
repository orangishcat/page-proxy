{
  "name": "page-proxy-extension",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "wxt prepare",
    "generate-monaco-types": "node ./scripts/generate-pp-monaco-extra-lib.mjs",
    "dev": "node ./scripts/generate-pp-monaco-extra-lib.mjs && wxt",
    "build": "node ./scripts/generate-pp-monaco-extra-lib.mjs && wxt build --browser firefox && wxt build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --fix",
    "test": "bun test tests",
    "clean": "wxt clean"
  },
  "dependencies": {
    "@page-proxy/pp": "workspace:*",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "bits-ui": "2.18.1",
    "css-selector-generator": "^3.8.1",
    "css-tree": "^3.2.1",
    "fast-deep-equal": "^3.1.3",
    "loglevel": "1.9.2",
    "lucide-svelte": "1.0.1",
    "monaco-editor": "0.56.0",
    "perfect-debounce": "^2.1.0",
    "picomatch": "4.0.5",
    "svelte": "5.56.8",
    "terser": "^5.46.1",
    "vite": "^8.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.2.2",
    "@types/css-tree": "^2.3.11",
    "@types/picomatch": "4.0.3",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.8.0",
    "postcss": "8.5.23",
    "svelte-check": "4.7.4",
    "svelte-eslint-parser": "1.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "wxt": "0.21.1"
  }
}
