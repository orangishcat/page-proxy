{
    "extends": "./.svelte-kit/tsconfig.json",
    "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
    "exclude": ["**/node_modules/**", "**/.pnpm/**", ".svelte-kit", "dist", "build"],
    "compilerOptions": {
        "types": ["svelte", "vite/client"],
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
    },
}
